@model SmithSwimmingSchool.Models.Swimmer
<h3>Register a new Swimmer</h3>

<form asp-controller="Swimmer"
	asp-action="AddVisitor" method="post">

	<label asp-for="SwimmerId"></label>

	<input asp-for="SwimmerId" /><br />

	<label asp-for="SwimmerName"></label>

	<input asp-for="SwimmerName" /><br />

	<label asp-for="Gender"></label>

	<input asp-for="Gender" /><br />

	<label asp-for="PhoneNumber"></label>

	<input asp-for="PhoneNumber" /><br />

	<label asp-for="DateOfBirth"></label>

	<input asp-for="DateOfBirth" /><br />

	<button type="submit">Add Swimmer</button>

</form>

@{
	ViewData["Title"] = "Visitor Registration | Smith Swimming School";
}
